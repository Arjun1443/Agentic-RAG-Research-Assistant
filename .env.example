# Hosted research model (no local language-model download)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Reuse the configured research provider for Mermaid generation.
DIAGRAM_MODEL_PROVIDER=existing
# Optional: select another available model on this provider.
# DIAGRAM_MODEL=openai/gpt-oss-20b

# Alternative OpenAI-compatible hosted provider (availability/quotas apply):
# DIAGRAM_MODEL_PROVIDER=huggingface
# DIAGRAM_MODEL=your_available_hosted_model
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_TOKEN=your_token

# Optional server-side Mermaid rendering configuration:
# MERMAID_CLI=/absolute/path/to/mmdc
# MERMAID_PUPPETEER_CONFIG=/absolute/path/to/puppeteer.json
