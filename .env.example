# Existing research model
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Diagram model. Qwen3-Coder generates Mermaid source, which is rendered
# into safe SVG/PNG/PDF diagram assets by the application.
DIAGRAM_MODEL_PROVIDER=huggingface
DIAGRAM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=your_huggingface_token

# For local Hugging Face/OpenAI-compatible inference:
# DIAGRAM_MODEL_PROVIDER=local
# HF_BASE_URL=http://127.0.0.1:8000/v1
# HF_TOKEN=local

# For hosted Hugging Face inference, set the provider URL and token.
# Hosted inference may incur provider charges.
# DIAGRAM_MODEL_PROVIDER=huggingface
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_TOKEN=your_huggingface_token

